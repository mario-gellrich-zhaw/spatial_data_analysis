{
	"name": "Python 3.12 with Jupyter and PDF Preview",
	"image": "mcr.microsoft.com/devcontainers/python:3.12",

	"features": {
		"ghcr.io/devcontainers/features/node:1": {
			"version": "lts"
		}
	},

	"forwardPorts": [8000],
	"portsAttributes": {
		"8000": {
			"label": "GNN Flask App",
			"onAutoForward": "openBrowser"
		}
	},

	"customizations": {
		"vscode": {
		"extensions": [
			"ms-python.python",
			"ms-toolsai.jupyter",
			"ms-azuretools.vscode-docker",
			"ms-python.autopep8",
			"ms-python.pylint",
			"analytic-signal.preview-pdf",
			"grapecity.gc-excelviewer",
			"github.copilot",
			"github.copilot-chat",
			"mechatroner.rainbow-csv"
		],
		"settings": {
			"workbench.colorTheme": "Default Dark+",
			"editor.rulers": [80],
			"workbench.iconTheme": "vs-seti"
		}
		}
	},

	"postCreateCommand": "sudo apt-get update && sudo apt-get install -y gdal-bin libgdal-dev && pip install -r requirements.txt && python -m spacy download en_core_web_sm && python -m spacy download de_core_news_sm"
}